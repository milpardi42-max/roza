# ── Rezi Atelier — environment template ──
# کپی به .env.local و مقداردهی کنید

# آدرس نهایی سایت (برای sitemap / robots / OG)
NEXT_PUBLIC_SITE_URL=https://reziatelier.com

# لایهٔ محتوا — خالی = فایل محلی content/cms/site-content.json
# مقادیر آینده: sanity | strapi
NEXT_PUBLIC_CMS=

# Sanity (وقتی فعال شد)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Strapi (جایگزین)
STRAPI_URL=
STRAPI_TOKEN=

# محافظت پنل ادمین (برای middleware در DEPLOY-CHECKLIST.md)
ADMIN_USER=
ADMIN_PASS=
